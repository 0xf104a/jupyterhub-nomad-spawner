<div class="mb-3">
    <label class="form-label" for="image">Image</label>
    <select class="form-select" id="image" name="image" required>
    {% for item in common_images %}
    <option value="{{ item }}">{{ item }}</option>
    {% endfor %}
    </select>
</div>

<div class="mb-3">
    <label class="form-label" for="datacenters">Datacenters</label>
    <select class="form-select" id="datacenters" name="datacenters" multiple required>
        {% for item in datacenters %}
        <option value="{{ item }}"{% if loop.first %} selected{% endif %}>{{ item }}</option>
        {% endfor %}
    </select>
</div>

<div class="mb-3"{% if lite_form %} hidden{% endif %}>
    <label class="form-label" for="memory">Memory (MB)</label>
    <input class="form-control" type="number" id="memory" name="memory" min="8"
           value="{{ memory_limit if memory_limit and memory_limit < 1024 else 1024 }}"
           {% if memory_limit %}max="{{ memory_limit }}"{% endif %}>
</div>

<fieldset class="mb-3"{% if lite_form %} hidden{% endif %}>
    <legend class="form-label">Volume</legend>
    <div class="form-check">
        <input class="form-check-input" type="radio" name="volume_type" id="volume_type_none" value="" checked>
        <label class="form-check-label" for="volume_type_none">None</label>
    </div>
    {% if not lite_form %}
    <div class="form-check">
        <input class="form-check-input" type="radio" name="volume_type" id="volume_type_ephemeral_disk" value="ephemeral_disk">
        <label class="form-check-label" for="volume_type_ephemeral_disk">Ephemeral Disk</label>
    </div>
    <div class="form-check">
        <input class="form-check-input" type="radio" name="volume_type" id="volume_type_csi" value="csi">
        <label class="form-check-label" for="volume_type_csi">CSI Volume</label>
    </div>
    <div class="form-check">
        <input class="form-check-input" type="radio" name="volume_type" id="volume_type_host" value="host">
        <label class="form-check-label" for="volume_type_host">Host Volume</label>
    </div>
    {% endif %}
</fieldset>

<div class="mb-3 host-volume" hidden>
    <label class="form-label" for="volume_source">Volume Source</label>
    <input class="form-control" id="volume_source" name="volume_source" value="jupyter">
</div>

{% if csi_plugin_ids %}
<div class="mb-3 csi-volume" hidden>
    <label class="form-label" for="volume_csi_plugin_id">Volume CSI Plugin ID</label>
    <select class="form-select" id="volume_csi_plugin_id" name="volume_csi_plugin_id">
        {% for item in csi_plugin_ids %}
        <option value="{{ item }}"{% if loop.first %} selected{% endif %}>{{ item }}</option>
        {% endfor %}
    </select>
</div>
{% endif %}

<div class="mb-3 volume-destination" hidden>
    <label class="form-label" for="volume_destination">Volume Destination</label>
    <input class="form-control" id="volume_destination" name="volume_destination" value="/home/jovyan/work">
</div>

<script>
(function () {
    function handleVolumeType(type) {
        document.querySelectorAll(".host-volume").forEach(function (el) {
            el.hidden = type !== "host";
        });
        document.querySelectorAll(".csi-volume").forEach(function (el) {
            el.hidden = type !== "csi";
        });
        document.querySelectorAll(".volume-destination").forEach(function (el) {
            el.hidden = !type;
        });
    }

    var radios = document.querySelectorAll("input[name=volume_type]");
    radios.forEach(function (radio) {
        radio.addEventListener("change", function () {
            handleVolumeType(radio.value);
        });
    });

    var checked = document.querySelector("input[name=volume_type]:checked");
    handleVolumeType(checked ? checked.value : "");
})();
</script>
